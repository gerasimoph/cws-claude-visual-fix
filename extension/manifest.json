{
  "manifest_version": 3,
  "name": "Browser Feedback for Coding Agents",
  "short_name": "Browser Feedback",
  "version": "0.1.0",
  "description": "Leave comments on your running app. Your coding agent fixes them — and the result is verified on the page.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup/popup.html", "default_title": "Browser Feedback" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*"],
      "js": ["lib/redact.js", "lib/onboarding.js", "content/anchor.js", "content/capture.js", "content/ui.js", "content/main.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "start-selecting": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Select an element to comment on"
    },
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Show or hide the review panel"
    }
  }
}
